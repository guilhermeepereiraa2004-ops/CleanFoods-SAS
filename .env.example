# Copie este arquivo para .env.local e preencha com os dados do painel do Supabase.
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA

# Apenas para código executado no servidor. Nunca use o prefixo NEXT_PUBLIC_.
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=sb_secret_SUA_CHAVE_SECRETA
SUPABASE_JWKS_URL=https://SEU_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
